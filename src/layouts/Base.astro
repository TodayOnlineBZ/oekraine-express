---
import '@fontsource-variable/manrope';
import '@fontsource-variable/dm-sans';
import '../styles/global.css';
import { Image } from 'astro:assets';
import Arrow from '../components/Arrow.astro';
import logoBlauw from '../assets/logo-blauw.png';
import logoWit from '../assets/logo-wit.png';
import { site, nav } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const {
  title = `${site.name} – ${site.tagline}`,
  description = 'Studenten en vrijwilligers brengen hulpgoederen naar de Pools-Oekraïense grens en helpen vluchtelingen op weg naar een veilige plek. Doneer of word vrijwilliger.',
  noindex = true,
} = Astro.props;
---
<!doctype html>
<html lang="nl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  {noindex && <meta name="robots" content="noindex, nofollow">}
  <link rel="icon" type="image/png" href="/favicon.png">
  <meta name="theme-color" content="#0D2A52">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:locale" content="nl_NL">
</head>
<body>
<div class="lx anim" data-root>
  <a class="skip" href="#inhoud">Naar de inhoud</a>

  <header class="hdr">
    <div class="wrap hdr-in">
      <a class="logo" href="/#top" aria-label={`${site.name} – naar boven`}>
        <Image class="lg-light" src={logoWit} alt={site.name} widths={[320, 640]} sizes="151px" loading="eager" />
        <Image class="lg-dark" src={logoBlauw} alt="" widths={[320, 640]} sizes="151px" loading="eager" />
      </a>
      <nav class="nav" aria-label="Hoofdnavigatie">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      </nav>
      <div class="hdr-actions">
        <button type="button" class="btn btn-sun btn-sm" data-mag data-donate-open>Doneer nu</button>
        <button type="button" class="menu-btn" aria-controls="lx-menu" aria-expanded="false" aria-label="Menu openen" data-menu-btn>
          <svg class="ico ico-open" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9h16"></path><path d="M8 15h12"></path></svg>
          <svg class="ico ico-close" viewBox="0 0 24 24" aria-hidden="true" hidden><path d="M6 6l12 12"></path><path d="M18 6L6 18"></path></svg>
        </button>
      </div>
    </div>
    <div class="mnav" id="lx-menu" hidden>
      <nav class="wrap" aria-label="Mobiel menu">
        <ul>
          {nav.map((n) => <li><a href={n.href}>{n.label} <Arrow /></a></li>)}
        </ul>
        <button type="button" class="btn btn-sun" data-donate-open>Doneer nu <Arrow /></button>
      </nav>
    </div>
  </header>

  <main id="inhoud">
    <slot />
  </main>

  <footer class="ftr light-focus">
    <div class="wrap">
      <p class="ftr-big" data-reveal="1">Door studenten,<br><span>voor Oekraïne.</span></p>
      <div class="ftr-grid">
        <div class="ftr-brand">
          <Image src={logoBlauw} alt={site.name} widths={[360, 720]} sizes="176px" />
          <p>Een initiatief van studenten uit Groningen. We brengen hulpgoederen naar de Pools-Oekraïense grens en helpen vluchtelingen op weg naar een veilige plek.</p>
        </div>
        <div>
          <h2 class="ftr-h">Contact</h2>
          <ul>
            <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
            <li><a href={site.messenger} target="_blank" rel="noopener">Stuur ons een bericht</a></li>
            <li><span>KvK {site.kvk}</span></li>
            <li><span>RSIN {site.rsin}</span></li>
          </ul>
        </div>
        <div>
          <h2 class="ftr-h">Volg ons</h2>
          <ul>
            {site.social.map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.label}</a></li>)}
          </ul>
        </div>
        <div>
          <h2 class="ftr-h">Meer</h2>
          <ul>
            <li><a href={site.links.wieZijnWij}>Over ons en ANBI</a></li>
            <li><a href={site.links.faq}>Veelgestelde vragen</a></li>
            <li><a href={site.links.privacy}>Privacyverklaring</a></li>
            <li><a href={site.links.disclaimer}>Disclaimer</a></li>
          </ul>
        </div>
      </div>
      <div class="ftr-bottom">
        <span>© {site.name}</span>
        <span>Website door <a href="https://todayonline.nl/" target="_blank" rel="noopener">TodayOnline</a></span>
      </div>
    </div>
  </footer>

  <dialog class="dlg light-focus" aria-labelledby="dlg-titel" data-donate>
    <form method="dialog">
      <button class="dlg-close" aria-label="Sluiten"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12"></path><path d="M18 6L6 18"></path></svg></button>
    </form>
    <span class="label">Doneer</span>
    <h2 id="dlg-titel">Kies een bedrag.</h2>
    <p>Je rondt je eenmalige donatie af bij bunq, in een nieuw tabblad.</p>
    <div class="amounts">
      {site.donate.amounts.map((n) => <a class="amount" href={`${site.donate.base}${n}`} target="_blank" rel="noopener">€ {n}</a>)}
    </div>
    <a class="btn btn-sun" href={site.donate.base} target="_blank" rel="noopener">Zelf een bedrag kiezen <Arrow /></a>
    {site.anbi && <p class="dlg-note">{site.name} heeft de ANBI-status. Je donatie is daardoor mogelijk aftrekbaar.</p>}
  </dialog>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-root]')!;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const clamp = (v: number) => Math.min(1, Math.max(0, v));

  // Donatievenster (native <dialog>: focus en Escape zitten ingebouwd)
  const dlg = document.querySelector<HTMLDialogElement>('[data-donate]')!;
  document.querySelectorAll('[data-donate-open]').forEach((b) =>
    b.addEventListener('click', () => { closeMenu(); dlg.showModal(); })
  );
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });

  // Mobiel menu
  const menuBtn = document.querySelector<HTMLButtonElement>('[data-menu-btn]')!;
  const menu = document.getElementById('lx-menu')!;
  function setMenu(open: boolean) {
    menu.hidden = !open;
    menuBtn.setAttribute('aria-expanded', String(open));
    menuBtn.setAttribute('aria-label', open ? 'Menu sluiten' : 'Menu openen');
    menuBtn.querySelector('.ico-open')!.toggleAttribute('hidden', open);
    menuBtn.querySelector('.ico-close')!.toggleAttribute('hidden', !open);
    hdr.classList.toggle('menu-open', open);
    if (open) menu.querySelector('a')?.focus();
  }
  function closeMenu() { if (!menu.hidden) setMenu(false); }
  menuBtn.addEventListener('click', () => setMenu(menu.hidden));
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeMenu));
  menu.addEventListener('keydown', (e) => { if (e.key === 'Escape') { setMenu(false); menuBtn.focus(); } });
  window.matchMedia('(min-width: 1081px)').addEventListener('change', (m) => { if (m.matches) closeMenu(); });

  // Magnetische knoppen
  let magEl: HTMLElement | null = null;
  if (!reduce && window.matchMedia('(hover: hover)').matches) {
    document.addEventListener('pointermove', (e) => {
      const t = (e.target as Element)?.closest?.<HTMLElement>('[data-mag]') ?? null;
      if (magEl && magEl !== t) { magEl.style.transform = ''; magEl = null; }
      if (!t) return;
      const b = t.getBoundingClientRect();
      t.style.transform = `translate(${((e.clientX - b.left - b.width / 2) * 0.18).toFixed(1)}px, ${((e.clientY - b.top - b.height / 2) * 0.3).toFixed(1)}px)`;
      magEl = t;
    });
  }

  const hdr = root.querySelector<HTMLElement>('.hdr')!;
  const heroImg = root.querySelector<HTMLElement>('[data-hero-img]');
  const pars = Array.from(root.querySelectorAll<HTMLElement>('[data-par]'));
  const quote = root.querySelector<HTMLElement>('[data-fill]');
  const words = quote ? Array.from(quote.querySelectorAll<HTMLElement>('.fw')) : [];
  const wide = root.querySelector<HTMLElement>('[data-wide]');
  const stps = Array.from(root.querySelectorAll<HTMLElement>('[data-stp]'));
  const list = root.querySelector<HTMLElement>('[data-stps]');
  const bar = root.querySelector<HTMLElement>('[data-sbar]');
  let raf = 0;

  function update() {
    raf = 0;
    const vh = window.innerHeight;
    hdr.classList.toggle('is-scrolled', window.scrollY > 40);

    // Sticky verhaal: actieve stap
    if (stps.length && list) {
      let active = 0;
      stps.forEach((s, i) => { if (s.getBoundingClientRect().top < vh * 0.55) active = i; });
      list.classList.toggle('live', list.getBoundingClientRect().height > vh);
      stps.forEach((s, i) => {
        s.classList.toggle('on', i === active);
        root.querySelector(`[data-simg="${i}"]`)?.classList.toggle('on', i === active);
        root.querySelector(`[data-sc="${i}"]`)?.classList.toggle('on', i === active);
      });
      if (bar) bar.style.transform = `scaleX(${((active + 1) / stps.length).toFixed(3)})`;
    }

    if (reduce) return;
    if (heroImg) heroImg.style.transform = `scale(${(1 + clamp(window.scrollY / 800) * 0.08).toFixed(4)})`;
    pars.forEach((el) => {
      const f = parseFloat(el.dataset.par || '0');
      const b = el.getBoundingClientRect();
      el.style.translate = `0 ${(((b.top + b.height / 2) - vh / 2) * f).toFixed(1)}px`;
    });
    if (quote && words.length) {
      const b = quote.getBoundingClientRect();
      const p = clamp((vh * 0.85 - b.top) / (b.height + vh * 0.35));
      words.forEach((w, k) => { w.style.opacity = (0.16 + 0.84 * clamp(p * words.length * 1.15 - k)).toFixed(3); });
    }
    if (wide) {
      const b = wide.getBoundingClientRect();
      const p = clamp((vh - b.top) / (vh * 0.85));
      wide.style.setProperty('--ins', `${((1 - p) * 5).toFixed(2)}%`);
      wide.style.setProperty('--rad', `${((1 - p) * 48).toFixed(1)}px`);
      const img = wide.querySelector<HTMLElement>('img');
      if (img) img.style.transform = `scale(${(1.12 - p * 0.12).toFixed(4)})`;
    }
  }
  const onScroll = () => { if (!raf) raf = requestAnimationFrame(update); };
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll);
  update();
</script>
</body>
</html>
