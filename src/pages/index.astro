---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import { site } from '../data/site';
import { ritten } from '../data/ritten';

import hero from '../assets/fotos/hero.jpg';
import missieGroep from '../assets/fotos/missie-groep.jpg';
import missieBus from '../assets/fotos/missie-bus.jpg';
import stapGeld from '../assets/fotos/stap-geld.jpg';
import stapBus from '../assets/fotos/stap-bus.jpg';
import stapMensen from '../assets/fotos/stap-mensen.jpg';
import breed from '../assets/fotos/breed.jpg';

const [uitgelicht, ...overige] = ritten;
const routeD = 'M0 100 Q 83 40 166 100 T 333 100 T 500 100 T 666 100 T 833 100 T 1000 100';
const stappen = [
  { n: 1, foto: stapGeld, alt: 'Vrijwilligers kopen hulpgoederen in bij een groothandel', titel: 'We zamelen geld in.',
    tekst: 'Elke rit begint bij donaties, via social media en het netwerk van onze vrijwilligers. Daarmee kopen we in wat op dat moment het hardst nodig is.' },
  { n: 2, foto: stapBus, alt: 'Een bus vol dozen met hulpgoederen, klaar voor vertrek', titel: 'We brengen hulp op weg.',
    tekst: 'Vrijwilligers rijden de volgeladen bus naar de grens. In het Poolse Medyka dragen ze de hulpgoederen over, waarna ze Oekraïne in gaan.' },
  { n: 3, foto: stapMensen, alt: 'Groepsfoto van bewoners en begeleiders voor opvanglocatie The Phoenix', titel: 'We helpen mensen verder.',
    tekst: 'Op de terugweg rijden vluchtelingen mee vanuit opvanglocaties bij de grens naar een veilige plek. Ook steunen we The Phoenix, een opvang in West-Oekraïne.',
    link: { href: site.links.phoenix, label: 'Over The Phoenix' } },
];
---
<Base>
<span id="top"></span>

<!-- HERO -->
<section class="hero" aria-labelledby="hero-titel">
  <div class="wrap hero-grid">
    <div class="hero-intro">
      <span class="eyebrow">{site.name}</span>
      <h1 class="h1" id="hero-titel"><span class="line">Samen brengen we</span> <span class="line"><span class="mark">hulp</span> op weg.</span></h1>
      <p class="lead hero-sub">Met de energie van studenten en vrijwilligers zetten we ons in voor mensen uit Oekraïne. Help mee met een donatie of steek zelf de handen uit de mouwen.</p>
      <div class="hero-ctas">
        <button type="button" class="btn btn-sun" data-donate-open>Doneer nu <Arrow /></button>
        <a class="btn btn-line" href="#help-mee">Word vrijwilliger</a>
      </div>
      <p class="hero-meta"><span class="dot" aria-hidden="true"></span>{site.tagline} · sinds 2022</p>
    </div>
    <div class="hero-art">
      <div class="hero-blob" aria-hidden="true"></div>
      <svg class="route-deco" viewBox="0 0 300 160" aria-hidden="true"><path d="M4 150 C 60 150, 70 40, 150 60 S 240 10, 296 30"></path></svg>
      <div class="hero-photo">
        <Image src={hero} data-hero-img alt="Drie lachende vrijwilligers met koffie in de bus, onderweg op een hulprit"
          widths={[480, 800, 1200]} sizes="(max-width: 900px) 92vw, 560px" loading="eager" fetchpriority="high" />
      </div>
      <div class="sun sun-hero" aria-hidden="true">
        <div class="sun-dot"></div>
        <svg viewBox="0 0 100 100" class="spin-slow" style="transform-origin: 50% 50%"><path class="spin" d="M84 50L96 50M79.4 67L89.8 73M67 79.4L73 89.8M50 84L50 96M33 79.4L27 89.8M20.6 67L10.2 73M16 50L4 50M20.6 33L10.2 27M33 20.6L27 10.2M50 16L50 4M67 20.6L73 10.2M79.4 33L89.8 27"></path></svg>
      </div>
      <div class="tag" aria-hidden="true"><span class="tag-ic"><svg class="ico" viewBox="0 0 24 24"><path d="M3 7h11v9H3z"></path><path d="M14 10h4l3 3v3h-7"></path><circle cx="7" cy="17" r="2"></circle><circle cx="17" cy="17" r="2"></circle></svg></span>Groningen → Pools-Oekraïense grens</div>
    </div>
  </div>
</section>

<!-- MISSIE -->
<section class="sec" id="missie" aria-labelledby="missie-titel">
  <div class="wrap missie-grid">
    <div class="missie-text">
      <span class="eyebrow" data-reveal="1">Onze missie</span>
      <h2 class="h2" id="missie-titel" data-reveal="2">Kleine acties. Samen veel betekenen.</h2>
      <p class="lead" data-reveal="3">{site.name} is opgericht door studenten uit Groningen. Na een eerste proefrit in maart 2022 sloten steeds meer vrienden en bekenden aan. Sindsdien rijden vrijwilligers bijna wekelijks naar de Pools-Oekraïense grens.</p>
      <p data-reveal="3">We geloven dat ieder mens recht heeft op veiligheid. Daarom brengen we hulpgoederen naar de grens en rijden we op de terugweg mensen naar een veilige plek. Het bestuur werkt onbezoldigd; elke rit draait op vrijwilligers die tijd, energie en hun netwerk inzetten.</p>
      <span class="brandline" data-reveal="4"><i aria-hidden="true"></i>{site.tagline}</span>
      <ul class="facts" data-reveal="4" aria-label="Kort over de stichting">
        <li>Opgericht in Groningen</li>
        <li>Ritten sinds maart 2022</li>
        <li>Meer dan 200 actieve vrijwilligers</li>
      </ul>
    </div>
    <div class="missie-photos" data-reveal="2">
      <span class="ring" aria-hidden="true"></span>
      <div class="mp-a"><Image src={missieGroep} alt="Zes vrijwilligers poseren samen in een loods vol hulpgoederen" widths={[600, 1000, 1400]} sizes="(max-width: 1060px) 92vw, 620px" /></div>
      <div class="mp-b"><Image src={missieBus} alt="Vrijwilliger in rode jas spreidt vrolijk de armen naast de busjes" widths={[300, 600]} sizes="(max-width: 640px) 55vw, 300px" /></div>
    </div>
  </div>
</section>

<!-- ZO HELPEN WE -->
<section class="sec help-sec" id="zo-helpen-we" aria-labelledby="help-titel" data-route>
  <div class="wrap">
    <div class="help-head">
      <div style="display: flex; flex-direction: column; gap: 16px">
        <span class="eyebrow" data-reveal="1">Zo helpen we</span>
        <h2 class="h2" id="help-titel" data-reveal="2">Van donatie tot<br>veilige plek.</h2>
      </div>
      <p class="lead" data-reveal="3">Een rit duurt drie dagen. Daarvoor is van alles nodig: geld, goederen, chauffeurs en tolken. Zo komt het samen.</p>
    </div>
    <div class="steps">
      <div class="steps-line" aria-hidden="true">
        <svg viewBox="0 0 1000 200" preserveAspectRatio="none">
          <path class="rl-base" d={routeD}></path>
          <path class="rl-prog" data-route-progress pathLength="1" d={routeD}></path>
          <path data-route-path d={routeD} style="fill: none; stroke: none"></path>
        </svg>
        <div class="bus" data-bus>
          <svg viewBox="0 0 52 34"><rect class="bus-body" x="2" y="4" width="46" height="22" rx="7"></rect><rect class="bus-win" x="34" y="8" width="10" height="8" rx="2"></rect><circle class="bus-wheel" cx="13" cy="27" r="5"></circle><circle class="bus-wheel" cx="37" cy="27" r="5"></circle></svg>
        </div>
      </div>
      <span class="vline" aria-hidden="true"><span class="vdot" data-vdot></span></span>
      <ol class="steps-grid" style="list-style: none; margin: 0; padding: 0">
        {stappen.map((s) => (
          <li class="step" data-reveal={String(s.n)}>
            <div class="step-img">
              <Image src={s.foto} alt={s.alt} widths={[200, 400]} sizes="200px" />
              <span class="step-num" aria-hidden="true">{s.n}</span>
            </div>
            <div class="step-body">
              <h3>{s.titel}</h3>
              <p>{s.tekst}</p>
              {s.link && <a class="tlink" href={s.link.href}><span>{s.link.label}</span><Arrow /></a>}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<!-- FOTOMOMENT -->
<section class="moment" aria-labelledby="moment-titel">
  <div class="wrap">
    <div class="moment-frame" data-zoom data-reveal="1">
      <div class="mf-img" style="width: 100%; height: 100%; overflow: hidden">
        <Image src={breed} alt="Een team vrijwilligers staat lachend naast hun busjes op een zonnige parkeerplaats" widths={[640, 1000, 1600]} sizes="(max-width: 1280px) 96vw, 1180px" />
      </div>
      <div class="moment-card">
        <h2 id="moment-titel">Hulp krijgt een gezicht.</h2>
        <p>Achter elke rit staan mensen die tijd vrijmaken om samen onderweg te zijn.</p>
      </div>
    </div>
  </div>
</section>

<!-- RITTEN -->
<section class="sec" id="ritten" aria-labelledby="ritten-titel">
  <div class="wrap">
    <div class="rit-head">
      <div>
        <span class="eyebrow" data-reveal="1">Onze ritten</span>
        <h2 class="h2" id="ritten-titel" data-reveal="2">Verhalen van onderweg.</h2>
      </div>
      <a class="tlink" href={site.links.ritten} data-reveal="3"><span>Alle ritten</span><Arrow /></a>
    </div>
    <div class="rit-grid">
      <a class="rit rit-feat" href={uitgelicht.href} data-reveal="1">
        <div class="rit-img"><Image src={uitgelicht.foto} alt={uitgelicht.alt} widths={[600, 900, 1300]} sizes="(max-width: 900px) 92vw, 700px" /></div>
        <div class="rit-body">
          <span class="rit-meta"><span class="rit-badge">Rit {uitgelicht.nummer}</span>{uitgelicht.meta}</span>
          <h3>{uitgelicht.titel}</h3>
          <p>{uitgelicht.intro}</p>
          <span class="go">Bekijk de rit <Arrow /></span>
        </div>
      </a>
      <div class="rit-side">
        {overige.map((r, i) => (
          <a class="rit rit-small" href={r.href} data-reveal={String(i + 2)}>
            <div class="rit-img"><Image src={r.foto} alt={r.alt} widths={[400, 800]} sizes="(max-width: 640px) 92vw, 260px" /></div>
            <div class="rit-body">
              <span class="rit-meta"><span class="rit-badge">Rit {r.nummer}</span>{r.meta}</span>
              <h3>{r.titel}</h3>
              <p>{r.intro}</p>
              <span class="go">Bekijk de rit <Arrow /></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- HELP MEE -->
<section class="sec cta dark" id="help-mee" aria-labelledby="cta-titel">
  <div class="cta-shape" aria-hidden="true">
    <svg viewBox="0 0 200 200" class="spin-slower" style="transform-origin: 50% 50%"><g class="spin"><circle cx="100" cy="100" r="44"></circle><circle cx="100" cy="100" r="64" style="stroke-dasharray: 2 6"></circle><path d="M100 4V24M100 176V196M4 100H24M176 100H196M32 32L46 46M154 154L168 168M168 32L154 46M46 154L32 168M63 11L71 30M137 170L129 189M11 137L30 129M189 63L170 71M137 11L129 30M63 189L71 170M11 63L30 71M189 137L170 129"></path></g></svg>
  </div>
  <div class="wrap">
    <div class="cta-head">
      <span class="eyebrow" data-reveal="1">Help mee</span>
      <h2 class="h2" id="cta-titel" data-reveal="2">Jouw energie maakt het verschil.</h2>
      <p class="lead" data-reveal="3">Iedere rit is mogelijk dankzij mensen die geven of meerijden. Kies wat bij jou past.</p>
    </div>
    <div class="cta-grid">
      <div class="route-card rc-donate" data-reveal="2">
        <span class="rc-ic" aria-hidden="true"><svg class="ico" viewBox="0 0 24 24"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"></path></svg></span>
        <h3>Doneer</h3>
        <p>Met jouw donatie kopen we hulpgoederen in en maken we ritten naar de grens mogelijk. Elk bedrag helpt.</p>
        <div class="rc-actions">
          <button type="button" class="btn btn-ink" data-donate-open>Doneer nu <Arrow /></button>
          <span class="rc-note">Veilig via bunq</span>
        </div>
      </div>
      <div class="route-card rc-vol" data-reveal="3">
        <span class="rc-ic" aria-hidden="true"><svg class="ico" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.5"></circle><path d="M2.5 20c.6-3.6 3.3-6 6.5-6s5.9 2.4 6.5 6"></path><path d="M16 4.5a3.5 3.5 0 0 1 0 7"></path><path d="M18 14.3c2 .8 3.2 2.9 3.5 5.7"></path></svg></span>
        <h3>Word vrijwilliger</h3>
        <p>Rij mee als chauffeur of help als tolk. Je hebt een rijbewijs en een geldig paspoort nodig; wij zorgen voor de bus en de contacten.</p>
        <div class="rc-actions">
          <a class="btn btn-sun" href={site.volunteerForm} target="_blank" rel="noopener">Ik help mee <Arrow /></a>
          <a class="tlink" href={site.links.vrijwilliger}><span>Meer informatie</span></a>
        </div>
      </div>
    </div>
    {site.anbi && <p class="anbi" data-reveal="4"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6z"></path><path d="M9 12l2 2 4-4"></path></svg>{site.name} is door de Belastingdienst aangemerkt als ANBI.</p>}
  </div>
</section>
</Base>
